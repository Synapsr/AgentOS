{
  "name": "@agentos/computer",
  "version": "0.1.0",
  "description": "Eyes and hands for the agent: see the screen, read the UI, use mouse and keyboard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentos/protocol": "workspace:*",
    "agent-desktop": "1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
