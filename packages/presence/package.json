{
  "name": "@agentos/presence",
  "version": "0.1.0",
  "description": "The agent's presence: three drops of light, as a pure model, a WebGL renderer and a small canvas renderer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "vite playground",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": { "@agentos/design": "workspace:*" },
  "devDependencies": { "typescript": "^5.9.3", "vite": "^7.1.0", "vitest": "^3.2.4" }
}
