---
/**
 * One short conversation, played on a phone with the live presence:
 * src/scripts/scene.ts plays it, through the data-* hooks below. The phone
 * shows the app's own home and request (docs/DESIGN.md, "iPhone, full
 * screen"), scaled to the phone. Without JavaScript it stays on its first
 * frame, which still reads.
 */
import Icon from "./Icon.astro";
import { copy, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const s = copy[Astro.props.lang].scene;
---

<figure class="scene" data-scene data-copy={JSON.stringify(s)} aria-label={s.label}>
  <div class="phone">
    <div class="screen" data-mode="home">
      <div class="light grain" aria-hidden="true"></div>
      <div class="status" aria-hidden="true">
        <span class="time">{s.time}</span>
        <span class="live" data-live><Icon name="earbuds" />{s.live}</span>
      </div>

      <div class="stage" data-stage></div>

      <div class="layer home" data-layer="home">
        <p class="name">{s.agent}</p>
        <p class="line" data-line aria-live="off">{s.greeting}</p>
        <p class="composer">
          <span class="placeholder" data-placeholder>{s.placeholder}</span>
          <span class="said" data-said></span>
          <span class="send" aria-hidden="true"><Icon name="voice" /></span>
        </p>
      </div>

      <div class="layer ask-layer" data-layer="request" inert>
        <p class="asking">{s.asking}</p>
        <p class="question">{s.question}</p>
        <div class="shot" data-appearance="light" role="img" aria-label={s.shot.label}>
          <div class="chrome"><i></i><i></i><i></i><span>{s.shot.url}</span></div>
          <div class="site">
            <div class="site-top"><b>{s.shot.brand}</b><span><i></i><i></i><i></i></span></div>
            <p class="site-title">{s.shot.headline}</p>
            <span class="pass"><Icon name="check" />{s.shot.badge}</span>
            <div class="tiles">{s.shot.tiles.map((tile) => <span>{tile}</span>)}</div>
          </div>
        </div>
        <p class="aloud" data-aloud><Icon name="earbuds" /><span>{s.saidAloud} · “{s.answer}”</span></p>
        <div class="tray stack" data-answers>
          <button class="btn primary" type="button" data-answer="go"><span class="check"><Icon name="check" /></span>{s.go}</button>
          <button class="btn secondary" type="button" data-answer="stop"><Icon name="hand" />{s.stop}</button>
        </div>
      </div>
    </div>
  </div>

  <figcaption>
    <div class="controls">
      <button class="icon-btn play" type="button" data-play aria-label={s.play} hidden>
        <Icon name="play" class="when-paused" />
        <Icon name="pause" class="when-playing" />
        <Icon name="replay" class="when-ended" />
      </button>
      <ol class="chapters">
        {
          s.chapters.map((name, i) => (
            <li>
              <button type="button" data-chapter={i} aria-label={s.chapter.replace("{name}", name)}>
                <span class="track">
                  <span class="fill" />
                </span>
                <span class="chapter">{name}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="caption">{s.caption}</p>
  </figcaption>
</figure>

<style>
  .scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
  }

  /* ───── The phone: the app's own surfaces, in the visitor's appearance ───── */

  .phone {
    /* As large as a real phone, but the whole scene fits in the window. */
    width: min(320px, 80vw, max(256px, (100svh - 270px) * 0.466));
    aspect-ratio: 9 / 19.3;
    padding: 9px;
    border-radius: 54px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-overlay);
  }

  .screen {
    position: relative;
    height: 100%;
    border-radius: 45px;
    background: var(--surface-stage);
    overflow: hidden;
    container-type: size;
    /* Where the presence stands: centred on the home screen, small and high while asking. */
    --y: 0cqh;
    --scale: 1;
    --light: var(--presence-idle);
    transition: --light var(--spring-material-duration) var(--spring-material);
  }

  .screen[data-mode="request"] {
    --y: -16cqh;
    --scale: 0.56;
    --light: var(--presence-waiting);
  }

  /* The stage light: the presence's colour, falling on the screen around it. */
  /* Placed by offsets, not a transform, so that its grain blends with the screen (see .grain). */
  .light {
    position: absolute;
    left: calc(50% - 75cqi);
    top: calc(40cqh - 75cqi + var(--y));
    width: 150cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--light) calc(var(--stage-light) * 100%), transparent), transparent);
    transition: top var(--spring-layout-duration) var(--spring-layout);
  }

  .status {
    position: absolute;
    inset: 0 8cqi auto;
    height: 15cqi;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 4.6cqi;
    font-weight: 600;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 1.2cqi;
    padding: 1cqi 2.6cqi 1cqi 2cqi;
    border-radius: var(--radius-full);
    background: var(--fill);
    color: var(--text-dim);
    font-size: 3.8cqi;
    font-weight: 600;
    transition:
      color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  /* Someone is talking through the earbuds. */
  .live.on {
    color: var(--text);
    background: var(--fill-strong);
  }

  .live :global(svg) {
    width: 4.4cqi;
    height: 4.4cqi;
  }

  .stage {
    position: absolute;
    left: 50%;
    top: 40cqh;
    width: 62cqi;
    height: 62cqi;
    transform: translate(-50%, -50%) translateY(var(--y)) scale(var(--scale));
    transition: transform var(--spring-layout-duration) var(--spring-layout);
    z-index: 1;
    pointer-events: none;
  }

  .layer {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--duration-exit) var(--ease-in),
      translate var(--duration-exit) var(--ease-in),
      filter var(--duration-exit) var(--ease-in),
      visibility 0s linear var(--duration-exit);
  }

  /* Leave: the layer that is not shown goes quietly, a little up. */
  .screen[data-mode="home"] .ask-layer,
  .screen[data-mode="request"] .home {
    opacity: 0;
    translate: 0 var(--leave-y);
    filter: blur(2px);
    visibility: hidden;
  }

  /* Arrive: once the presence has moved out of its way, from a little below. */
  .screen[data-mode="home"] .home,
  .screen[data-mode="request"] .ask-layer {
    transition:
      opacity var(--duration-base) var(--ease-out) 280ms,
      translate var(--spring-gesture-duration) var(--spring-gesture) 280ms,
      filter var(--duration-base) var(--ease-out) 280ms;
  }

  .screen[data-mode="home"] .ask-layer {
    translate: 0 var(--arrive-y);
  }

  /* ───── Home: the name, the presence, the line, the composer ───── */

  .name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(60cqh + 29cqi);
    text-align: center;
    color: var(--text-dim);
    font-size: 3.8cqi;
    font-weight: 600;
  }

  /* The line, in Display: display-s on a phone. */
  .line {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    top: calc(40cqh + 29cqi);
    text-align: center;
    font-weight: 400;
    font-size: 7.2cqi;
    line-height: 1.16;
    letter-spacing: var(--tracking-display-s);
    text-wrap: balance;
  }

  .composer {
    position: absolute;
    left: 5cqi;
    right: 5cqi;
    bottom: 6cqi;
    min-height: 14.4cqi;
    display: flex;
    align-items: center;
    gap: 2cqi;
    padding: 2cqi 2cqi 2cqi 5cqi;
    border-radius: 7.2cqi;
    background: var(--surface-raised);
    box-shadow: var(--shadow-raised);
    font-size: 4.1cqi;
    line-height: 1.3;
  }

  /* A placeholder, drawn: dim rather than faint, so that it still reads at phone size. */
  .placeholder {
    flex: 1;
    color: var(--text-dim);
  }

  .said {
    flex: 1;
  }

  .said:empty {
    display: none;
  }

  .composer:has(.said:not(:empty)) .placeholder {
    display: none;
  }

  /* Words land as they are heard, like dictation: no fade. */
  .said :global(.word) {
    opacity: 0;
  }

  .said :global(.word.on) {
    opacity: 1;
  }

  .send {
    display: grid;
    place-items: center;
    flex: none;
    align-self: flex-end;
    width: 10.4cqi;
    height: 10.4cqi;
    border-radius: 50%;
    background: var(--fill);
    color: var(--text-dim);
  }

  .send :global(svg) {
    width: 5cqi;
    height: 5cqi;
  }

  /* ───── Request: who asks, the question, what Nova sees, the decision ───── */

  .ask-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(24cqh + 18cqi) 5cqi 6cqi;
    text-align: center;
  }

  .ask-layer .asking {
    color: var(--waiting);
    font-size: 3.8cqi;
    font-weight: 600;
  }

  .question {
    margin-top: 2cqi;
    font-weight: 400;
    font-size: 7.2cqi;
    line-height: 1.16;
    letter-spacing: var(--tracking-display-s);
    text-wrap: balance;
    white-space: pre-line;
  }

  .aloud {
    display: flex;
    align-items: center;
    gap: 1.6cqi;
    margin-top: auto;
    margin-bottom: 3cqi;
    color: var(--text-dim);
    font-size: 3.6cqi;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .aloud :global(svg) {
    width: 4.4cqi;
    height: 4.4cqi;
  }

  .aloud.on {
    opacity: 1;
  }

  /* Stacked in the thumb zone: Go ahead on top, Stop below, 56 points each on a real phone. */
  .tray {
    width: 100%;
    gap: 2.6cqi;
    padding: 0;
  }

  .tray .btn {
    --h: 14.4cqi;
    gap: 2cqi;
    padding-inline: 4cqi;
    font-size: 4.4cqi;
  }

  .tray .btn :global(svg) {
    width: 5.2cqi;
    height: 5.2cqi;
  }

  /* The buttons wait while nobody is asked: they keep their look, they just do not answer. */
  .tray .btn:disabled {
    cursor: default;
  }

  /* What Nova sees: a light web page, drawn rather than pictured, with the phone's picture radius. */
  .shot {
    width: 100%;
    margin-top: 4cqi;
    border-radius: 5.6cqi;
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
    outline: 1px solid var(--outline);
    outline-offset: -1px;
    text-align: left;
    font-size: 2.4cqi;
    line-height: 1.2;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.9cqi;
    padding: 1.6cqi 2.4cqi;
    background: var(--fill-strong);
  }

  .chrome i {
    width: 1.5cqi;
    height: 1.5cqi;
    border-radius: 50%;
    background: var(--fill-strong);
  }

  .chrome span {
    flex: 1;
    margin-left: 2cqi;
    margin-right: 6cqi;
    padding: 0.5cqi 2cqi;
    border-radius: var(--radius-full);
    background: var(--surface-raised);
    color: var(--text-dim);
    text-align: center;
    font-size: 2.1cqi;
    white-space: nowrap;
    overflow: hidden;
  }

  .site {
    padding: 3.2cqi 3.6cqi 3.6cqi;
    background: var(--surface-raised);
  }

  .site-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 2.4cqi;
  }

  .site-top span {
    display: flex;
    gap: 1.6cqi;
  }

  .site-top i {
    width: 4.5cqi;
    height: 0.9cqi;
    border-radius: 1cqi;
    background: var(--fill-strong);
  }

  .site-title {
    margin-top: 3cqi;
    max-width: 62%;
    font-size: 4.6cqi;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .pass {
    display: inline-flex;
    align-items: center;
    gap: 0.8cqi;
    margin-top: 2.4cqi;
    padding: 0.8cqi 2.2cqi 0.8cqi 1.6cqi;
    border-radius: var(--radius-full);
    background: var(--text);
    color: var(--surface-raised);
    font-size: 2.2cqi;
    font-weight: 600;
  }

  .pass :global(svg) {
    width: 2.6cqi;
    height: 2.6cqi;
    stroke-width: 2.4;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6cqi;
    margin-top: 3cqi;
  }

  .tiles span {
    display: flex;
    align-items: flex-end;
    height: 11cqi;
    padding: 1.2cqi 1.6cqi;
    border-radius: 1.4cqi;
    background: var(--fill);
    font-size: 2.1cqi;
    font-weight: 600;
  }

  /* ───── The controls under the phone ───── */

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    width: min(400px, 100%);
  }

  .controls {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    width: 100%;
  }

  .play :global(svg) {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    display: none;
  }

  .play[data-status="paused"] :global(.when-paused),
  .play[data-status="playing"] :global(.when-playing),
  .play[data-status="ended"] :global(.when-ended) {
    display: block;
  }

  .chapters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    flex: 1;
  }

  .chapters button {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    height: 100%;
    min-height: var(--size-control);
    padding: var(--space-8) var(--space-4);
    border-radius: var(--radius-s);
    color: var(--text-dim);
    text-align: left;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .chapters button:hover,
  .chapters button[aria-current="step"] {
    color: var(--text);
  }

  .track {
    display: block;
    width: 100%;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--fill-strong);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: currentColor;
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  .chapter {
    font: var(--type-label);
    letter-spacing: var(--tracking-label);
    text-wrap: balance;
  }

  .caption {
    color: var(--text-dim);
    font: var(--type-small);
    text-align: center;
  }
</style>
