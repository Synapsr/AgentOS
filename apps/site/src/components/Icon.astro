---
/**
 * Line icons on a 24-unit grid, stroke 1.75, round caps: the product's own
 * set (docs/DESIGN.md, "Icons"). Decorative by default: next to its word an
 * icon is hidden from screen readers. The GitHub mark is a logo, not an
 * icon, and is filled.
 */
interface Props {
  name: keyof typeof shapes;
  label?: string;
  class?: string;
}

const shapes = {
  check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
  close: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>',
  hand: '<path d="M8.5 12.5V6.75a1.5 1.5 0 0 1 3 0V11.5M11.5 11V5.25a1.5 1.5 0 0 1 3 0V11.5M14.5 11.5V6.75a1.5 1.5 0 0 1 3 0v7.75a6 6 0 0 1-6 6h-.6a5.5 5.5 0 0 1-4.3-2.1l-2.7-3.5a1.55 1.55 0 0 1 2.3-2.05L8.5 15V12.5"/>',
  alert: '<path d="M10.3 4.6a2 2 0 0 1 3.4 0l7 12.1A2 2 0 0 1 19 19.7H5a2 2 0 0 1-1.7-3l7-12.1Z"/><path d="M12 9.5v4"/><path d="M12 16.6h.01"/>',
  chevron: '<path d="M10 6.5l5.5 5.5-5.5 5.5"/>',
  down: '<path d="M6.5 10l5.5 5.5 5.5-5.5"/>',
  back: '<path d="M14 6.5L8.5 12l5.5 5.5"/>',
  zoom: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l4.5 4.5M10.5 8v5M8 10.5h5"/>',
  copy: '<rect x="8.5" y="8.5" width="11" height="11" rx="2.5"/><path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2"/>',
  voice: '<path d="M7 9.5v5M12 6v12M17 9.5v5"/>',
  phone: '<rect x="6.5" y="2.75" width="11" height="18.5" rx="3"/><path d="M10.5 18h3"/>',
  watch: '<rect x="6.5" y="6.5" width="11" height="11" rx="3"/><path d="M9 6.5l.6-3h4.8l.6 3M9 17.5l.6 3h4.8l.6-3"/>',
  screen: '<rect x="3.5" y="4.5" width="17" height="11.5" rx="2.5"/><path d="M9 20h6M12 16v4"/>',
  key: '<circle cx="8" cy="15" r="3.75"/><path d="M10.7 12.3L19 4M16 7l2.5 2.5M14 9l2 2"/>',
  shield: '<path d="M12 3.5l7 2.6v5.4c0 4.4-2.9 7.7-7 9-4.1-1.3-7-4.6-7-9V6.1l7-2.6Z"/>',
  bolt: '<path d="M13 3.5L5.5 13.5H12l-1 7 7.5-10H12l1-7Z"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.4 3.5 5.3 3.5 8.5s-1.1 6.1-3.5 8.5c-2.4-2.4-3.5-5.3-3.5-8.5S9.6 5.9 12 3.5Z"/>',
  play: '<path d="M8.5 6.2v11.6a1 1 0 0 0 1.5.86l9.3-5.8a1 1 0 0 0 0-1.72L10 5.34a1 1 0 0 0-1.5.86Z"/>',
  pause: '<path d="M9 6v12M15 6v12"/>',
  replay: '<path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3M4.5 4.5v4h4"/>',
  /** An empty circle: not done yet. */
  planned: '<circle cx="12" cy="12" r="8"/>',
  earbuds:
    '<path d="M8 4.5a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3V19.5M8 4.5a2.5 2.5 0 0 1 2.5 2.5v2a2.5 2.5 0 0 1-2.5 2.5M16 4.5a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3V19.5M16 4.5a2.5 2.5 0 0 0-2.5 2.5v2a2.5 2.5 0 0 0 2.5 2.5"/>',
  laptop: '<rect x="4" y="5" width="16" height="11" rx="2"/><path d="M2.5 19h19"/>',
  browser: '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9h17M7 6.75h.01M9.5 6.75h.01"/>',
  server: '<rect x="4" y="4.5" width="16" height="6" rx="2"/><rect x="4" y="13.5" width="16" height="6" rx="2"/><path d="M7.5 7.5h.01M7.5 16.5h.01"/>',
  /** Drawn below: a logo, filled. */
  github: "",
};

const { name, label, class: className = "" } = Astro.props;
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

{
  name === "github" ? (
    <svg class:list={["github", className]} viewBox="0 0 24 24" width="20" height="20" fill="currentColor" {...a11y}>
      <path d="M12 2.2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2.2z" />
    </svg>
  ) : (
    <svg class:list={["icon", className]} viewBox="0 0 24 24" width="20" height="20" {...a11y} set:html={shapes[name]} />
  )
}
