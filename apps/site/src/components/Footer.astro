---
import mark from "@agentos/design/brand/mark.svg?raw";
import { copy, other, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** Which page it closes: the language link keeps the visitor on it. */
  page?: "home" | "developers";
}

const { lang, page = "home" } = Astro.props;
const t = copy[lang];
const alt = copy[other(lang)];
const there = page === "developers" ? alt.devPath : alt.path;
---

<footer class="foot">
  <div class="wrap row">
    <div class="who">
      <span class="mark" aria-hidden="true" set:html={mark} />
      <div>
        <p>{t.footer.tagline}</p>
        <p class="dim">{t.footer.license}</p>
      </div>
    </div>
    <nav aria-label="AgentOS">
      <ul>
        <li><a href={t.devPath} aria-current={page === "developers" ? "page" : undefined}>{t.nav.developers}</a></li>
        {t.footer.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li>
          <a href={there} hreflang={alt.lang} lang={alt.lang}>{t.nav.language}</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .foot {
    padding-block: var(--space-44) var(--space-64);
    box-shadow: inset 0 1px 0 var(--line);
    font: var(--type-small);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-24) var(--space-44);
  }

  .who {
    display: flex;
    gap: var(--space-16);
  }

  .mark {
    width: 28px;
    height: 28px;
    flex: none;
    color: var(--text);
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-inline: calc(-1 * var(--space-12));
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-control);
    padding-inline: var(--space-12);
    border-radius: var(--radius-full);
    color: var(--text-dim);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    a:hover {
      color: var(--text);
      background-color: var(--fill);
    }
  }
</style>
