---
/**
 * The one page a static server shows for any address it does not know, so
 * it speaks both languages.
 */
import Base from "../layouts/Base.astro";
import { copy } from "../i18n";
---

<Base lang="en" title="Page not found — AgentOS" description={copy.en.meta.description} noindex>
  <main id="main" class="lost">
    <div class="stage" data-presence="idle"></div>
    <p class="name">Nova</p>
    <h1>I looked everywhere. This page isn’t here.</h1>
    <p class="fr" lang="fr">J’ai cherché partout. Cette page n’existe pas.</p>
    <div class="actions">
      <a class="btn lg primary" href="/">Back to AgentOS</a>
      <a class="btn lg secondary" href="/fr/" lang="fr" hreflang="fr">Retour à l’accueil</a>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: var(--space-44) var(--space-24);
    text-align: center;
  }

  .stage {
    width: 200px;
    height: 200px;
    order: -1;
    margin-block: var(--space-8);
  }

  .name {
    order: -2;
    color: var(--text-dim);
    font: var(--type-label);
  }

  h1 {
    margin-top: var(--space-16);
    font: var(--type-display-m);
    letter-spacing: var(--tracking-display-m);
    text-wrap: balance;
    max-width: 18em;
  }

  .fr {
    margin-top: var(--space-12);
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-12);
    margin-top: var(--space-44);
  }
</style>
