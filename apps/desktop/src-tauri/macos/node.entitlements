<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For the Node.js inside the app (scripts/assemble-runtime.mjs signs it with
  these). V8 writes machine code while it runs, which the hardened runtime
  forbids unless asked. Node.js's own release asks for more (loading libraries
  signed by others, debugging); the core loads none and is not debugged here.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
