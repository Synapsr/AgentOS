    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scan the code shown on your computer."
          }
        },
        "fr" : {
          "stringUnit" : {
