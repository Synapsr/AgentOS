          }
        }
      }
    },
    "I can't reach %@ safely any more. Add it again from your computer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne peux plus joindre %@ en sécurité. Ajoutez-le à nouveau depuis votre ordinateur."
          }
        }
      }
    },
    "I can't reach %@ safely from this network. Update AgentOS on your computer, then show a new code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne peux pas joindre %@ en sécurité sur ce réseau. Mettez à jour AgentOS sur votre ordinateur, puis affichez un nouveau code."
          }
        }
      }
    },
    "I can't reach %@ safely: its relay address starts with http. Give the relay an https address, then show a new code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne peux pas joindre %@ en sécurité : l'adresse de son relais commence par http. Donnez au relais une adresse en https, puis affichez un nouveau code."
          }
        }
      }
    },
    "I can't reach %@. Check that it's awake." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n'arrive pas à joindre %@. Vérifiez qu'il est allumé."
          }
        }
      }
    },
    "I can't reach %@. Check that your phone is on the same network as your computer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
