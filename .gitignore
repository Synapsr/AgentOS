# Dependencies and builds
node_modules/
dist/
target/
coverage/
*.tsbuildinfo

# OS and editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?

# Logs
*.log

# Secrets: must never land in a public repository
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.mobileprovision

# Local agent scratch
.claude/

# Xcode (the project is generated by XcodeGen from apps/ios/project.yml)
apps/ios/*.xcodeproj/
apps/ios/build/
DerivedData/
xcuserdata/
*.xcresult

# Tauri (the runtime the app carries is assembled by apps/desktop/scripts)
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/
*.dmg

# Android
apps/android/.gradle/
apps/android/build/
apps/android/local.properties

# A relay run from the clone (see packages/relay)
relay-data/

# Website QA captures (kept locally, not part of the repository)
apps/site/screenshots/
